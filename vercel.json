{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.advancedconcretedallas.com" }],
      "headers": { "Location": "https://advancedconcretedallas.com/$1" },
      "status": 301
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
